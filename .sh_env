#!/not/executable/bash
# Environment shared by interactive Bash and Zsh sessions.
. "$HOME/.sh_plugins.d/basics.sh"
. "$HOME/.sh_lib/functions.d/has.sh"
. "$HOME/.sh_lib/functions.d/trysource.sh"

# Re-sourcing should not repeatedly prepend the same paths.
if [ -z "${__orig_PATH:-}" ]; then
  export __orig_PATH="$PATH"
else
  PATH="$__orig_PATH"
fi

export CPUTYPE OSTYPE
CPUTYPE="$(uname -m)"
OSTYPE="$(uname -s | tr '[:upper:]' '[:lower:]')"

# Locate an existing Homebrew installation without installing or updating it.
HOMEBREW=
for dotfiles_brew in \
  "${HOMEBREW_PREFIX:-/nonexistent}/bin/brew" \
  /opt/homebrew/bin/brew \
  /usr/local/bin/brew \
  /home/linuxbrew/.linuxbrew/bin/brew; do
  if [ -x "$dotfiles_brew" ] && ! [ "$dotfiles_brew" -ef "$HOME/bin/brew" ]; then
    HOMEBREW="$dotfiles_brew"
    break
  fi
done
if [ -n "$HOMEBREW" ]; then
  HOMEBREW_PREFIX="$("$HOMEBREW" --prefix)"
  export HOMEBREW HOMEBREW_PREFIX
  export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
  # Homebrew's GNU tools otherwise retain their g-prefixed names on macOS.
  for dotfiles_package in coreutils findutils gnu-sed grep; do
    dotfiles_gnubin="$HOMEBREW_PREFIX/opt/$dotfiles_package/libexec/gnubin"
    if [ -d "$dotfiles_gnubin" ]; then
      PATH="$dotfiles_gnubin:$PATH"
    fi
  done
fi
unset dotfiles_brew dotfiles_package dotfiles_gnubin

export PATH="$HOME/.local/bin:$HOME/private-dotfiles/bin:$HOME/bin:$PATH"
export GOPATH="$HOME/prefix/gopath"
export VOLTA_HOME="$HOME/.volta"
if [ -d "$VOLTA_HOME/bin" ]; then
  PATH="$VOLTA_HOME/bin:$PATH"
fi
export GEM_HOME="$HOME/prefix/rubygems"
export REPO="$HOME/repo"
export EDITOR=vim
export VISUAL="$EDITOR"
export GIT_EDITOR="$EDITOR"
export PYTHONSTARTUP="$HOME/.pythonrc.py"
export EMAIL
EMAIL="$(git config user.email 2>/dev/null)"

export LESS='-XFR -i -M -w -z-4'
export PAGER=less
if [ -x /usr/bin/lesspipe ]; then
  eval "$(SHELL=/bin/sh lesspipe)"
fi

case "$OSTYPE" in
  darwin*)
    export BROWSER=open
    # An inherited agent, including one forwarded over SSH, takes precedence.
    dotfiles_agent="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -S "$dotfiles_agent" ]; then
      export SSH_AUTH_SOCK="$dotfiles_agent"
    fi
    unset dotfiles_agent
    ;;
esac

if [ -t 0 ]; then
  stty -ixon -ixoff
fi

# TERM belongs to the terminal emulator or tmux; do not replace it here.
if has infocmp && infocmp -1GLx 2>/dev/null | grep -Eq '^[[:space:]]*(Tc|setrgbf)[=,]'; then
  export CLICOLOR=1 COLORTERM=truecolor
elif has infocmp && infocmp -1GLx 2>/dev/null | grep -Eq '^[[:space:]]*set_a_foreground[=,]'; then
  export CLICOLOR=1 COLORTERM=1
else
  unset CLICOLOR COLORTERM
fi

. "$HOME/.sh_lib/functions.d/bootstamp.sh"
export BOOT
BOOT="$(bootstamp)"

# Keep the system-provided temporary directory and its permissions unchanged.
# If it is unavailable, create a private directory without modifying /tmp.
if [ -z "${TMPDIR:-}" ] || [ ! -d "$TMPDIR" ] || [ ! -w "$TMPDIR" ] || [ ! -x "$TMPDIR" ]; then
  TMPDIR="$(umask 077; mktemp -d /tmp/kent-dotfiles.XXXXXXXX)" || return 1
fi
export TMPDIR
. "$HOME/.sh_plugins.d/xdg.sh"

trysource "$HOME/.cargo/env"
if has aactivator; then
  eval "$(aactivator init)"
fi
# Machine and work settings override shared defaults.
trysource "$HOME/private-dotfiles/.sh_env"
export DOTFILES_ENV_LOADED=1
# vim:et:sw=2:sts=2:
