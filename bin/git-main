#!/bin/bash
set -euo pipefail
upstream="$(git upstream)"
remote="${upstream%%/*}"
branch="${upstream#*/}"

set -x
git fetch "$remote" "refs/heads/$branch:refs/remotes/$upstream"
if git show-ref --verify --quiet "refs/heads/$branch"; then
    git switch "$branch"
else
    git switch --track -c "$branch" "$upstream"
fi
git merge --ff-only "$upstream"
