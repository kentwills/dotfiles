#!/bin/sh
# Compatibility entry point for machines where ~/bin precedes Homebrew.
# Never install software or rewrite system paths as a side effect.
for dotfiles_brew in \
  "${HOMEBREW_PREFIX:-/nonexistent}/bin/brew" \
  /opt/homebrew/bin/brew \
  /usr/local/bin/brew \
  /home/linuxbrew/.linuxbrew/bin/brew; do
  if [ -x "$dotfiles_brew" ] && ! [ "$dotfiles_brew" -ef "$0" ]; then
    exec "$dotfiles_brew" "$@"
  fi
done
printf '%s\n' 'Homebrew is not installed. See https://brew.sh/.' >&2
exit 127
