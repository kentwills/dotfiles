[user]
    name = Kent Wills
    email = rkwills@yelp.com
[core]
    excludesfile = ~/.gitignore_global
[init]
    defaultBranch = main
[color]
    ui = true
[pack]
    threads = 0
    packSizeLimit = 64m
[diff]
    renamelimit = 0
    tool = vimdiff
    algorithm = histogram
    # detect renames and copies by default
    renames = copy
    color-moved = zebra
    # relative = false  # break git-vimdiff otherwise
    relative = true  # less useful otherwise
    # SADFACE: these don't work (yet?)
    find-renames = 0.1
    find-copies =  0.1
    find-copies-harder = true
[difftool]
    prompt = false
[difftool "vimdiff"]
    # Keep Git commands inside Vim independent of the parent diff invocation.
    # Shell builtins work with both macOS and GNU userlands.
    cmd = "(unset GIT_EXTERNAL_DIFF GIT_DIR GIT_WORK_TREE; vim -f -d -c \"wincmd l\" \"$LOCAL\" \"$REMOTE\")"
[merge]
    renamelimit = 0
    tool = vimmerge
    conflictstyle = diff3
[mergetool]
    prompt = false
    keepBackup = false
    trustExitCode = true
[mergetool "vimmerge"]
    cmd = vimmerge \"$REMOTE\" \"$MERGED\" \"$LOCAL\" \"$BASE\"
[push]
    default = current
[pull]
    ff = only
[advice]
    detachedHead = false
[alias]
    ff = !sh -exc 'git pull --ff "$@"' -
    branch-name = symbolic-ref -q --short HEAD
    tag-name = !sh -exc 'git tag -l --points-at ${1:-HEAD}' -
    base = !sh -exc 'git merge-base "$(git upstream)" ${1:-HEAD}' -
    diffbase = !sh -c 'git diff -M -C `git base` "$@"' -
    lol = !git log --oneline --graph --decorate --color=always --pretty=format:'%C(auto)%h - %C(bold blue)%aE%Cgreen(%cr)%C(auto)%d%Creset %s' "$@" | \
        sed 's/@yelp.com//' | \
        less -XLFR && true
    l = lol
    xl = lol --all
    feature = !sh -ec 'b="kentwills/$1" && shift 1 && set -x && git master && git checkout -b "$b" "$@"' -
    vimdiff = difftool
    dt = difftool
    d = difftool
    mt = mergetool
    wip = commit -m 'WIP' --no-verify
    amend = commit --amend --no-edit
    amendall = amend --all
    co = checkout
    ci = commit
    top = rev-parse --show-toplevel
    s = status -s
    topic = !set -x && git fetch origin master && git checkout FETCH_HEAD -b
[http]
    cookiefile = ~/.gitcookies
[include]
    path = ./private-dotfiles/.gitconfig

# vim:sts=4:sw=4:et:

[rerere]
    # Do not reuse recorded conflict resolutions.
    enabled = false
[help]
    autocorrect = 1
[pager]
    show = vim -R -
    color = false
